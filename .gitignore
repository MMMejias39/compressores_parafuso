# Artefatos de compilação do LaTeX (regeráveis via pdflatex)
*.aux
*.log
*.out
*.toc
*.nav
*.snm

# Ambiente Python e cache (regenerável via scripts/venv)
scripts/venv/
scripts/__pycache__/

# Aplicativo simulador (regenerável via aplicativo/requirements.txt)
aplicativo/venv/
aplicativo/**/__pycache__/
