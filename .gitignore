# Artefatos de compilação do LaTeX (regeráveis via pdflatex)
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.nav
*.snm

# Ambiente Python e cache (regenerável via scripts/venv)
scripts/venv/
scripts/__pycache__/

# Aplicativo simulador (regenerável via aplicativo/requirements.txt)
aplicativo/venv/
aplicativo/**/__pycache__/

# Launcher .desktop com caminho absoluto — específico de cada máquina/clone
# (iniciar_simulador.sh, o script em si, é portável e continua versionado)
aplicativo/iniciar_simulador.desktop

# Configuração local do Claude Code (pessoal, não compartilhada)
.claude/settings.local.json

# Ferramentas locais baixadas (binários grandes, específicos da máquina).
# .tools/ guarda o binário do tectonic (~60 MB) e o tarball de instalação
# (~22 MB) — 79 MB no total. É ferramenta de build, não conteúdo do projeto:
# reinstalável a partir da distribuição oficial do tectonic.
.tools/

# Rust & Cargo build artifacts
target/
**/target/
Cargo.lock

# Node.js & Puppeteer
node_modules/
**/node_modules/

